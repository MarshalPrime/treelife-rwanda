# Copy to .env for local development. Never commit .env.
# These values are for a local demo only. Replace them before any shared deployment.

APP_ENV=development
SECRET_KEY=dev-only-change-me-use-a-long-random-string
POSTGRES_HOST_PORT=5433
# When overriding POSTGRES_HOST_PORT, update the port in DATABASE_URL as well.
WEB_HOST_PORT=3000
DATABASE_URL=postgresql+psycopg://treelife:treelife@localhost:5433/treelife
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Load synthetic species, organizations, users, sites, and trees.
# Keep this false for any shared or production environment.
SEED_DEMO_DATA=true

# Development demo passwords. Used only by `python -m app.seed` when APP_ENV is not production.
DEMO_ADMIN_PASSWORD=demo-admin-pass
DEMO_OFFICER_PASSWORD=demo-officer-pass
DEMO_VIEWER_PASSWORD=demo-viewer-pass
DEMO_FARMER_PASSWORD=demo-farmer-pass

# Frontend (also read from the shell when you run `npm run dev`)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Assistant. Set these on the API only: this file locally, or the API project on Vercel.
# Do not put the key on the website project. It stays on the server.
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.5-flash
